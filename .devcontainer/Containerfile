# Dev container for Filo (Go). Build and run it with scripts/dev.sh.
#
# GO_IMAGE tracks the newest Go 1.x image so a rebuild picks up current releases.
# Once you have checked https://go.dev/dl and the golang tags on Docker Hub, pin an exact tag
# (e.g. docker.io/library/golang:1.xx.y) so every clean checkout builds the same toolchain.
ARG GO_IMAGE=docker.io/library/golang:1.27.4
FROM ${GO_IMAGE}

# Match the host user so files written to the mounted repo are owned by you (rootless podman, --userns=keep-id).
ARG UID=1000
ARG GID=1000

ARG INSTALL_CLAUDE=0

# sqlite3 is for inspecting filo.db by hand; the rest are everyday tools.
RUN apt-get update \
 && apt-get install -y --no-install-recommends sqlite3 ripgrep less procps \
 && rm -rf /var/lib/apt/lists/*

# Node, only to test the tag index's find page script (node --test, run from go test; no npm packages). The LTS
# release, pinned with the checksums from https://nodejs.org/dist/<version>/SHASUMS256.txt; the .tar.gz, since the
# image has no xz.
ARG NODE_VERSION=v26.13.1
ARG NODE_SHA256_X64=518674de2b621728a5e4486f5fb3b7d2900bb3cc4aa97969edaa463db99f9778
ARG NODE_SHA256_ARM64=80a330b35415382878df18d41afbd106ea89bfb3be0087d6608e289a14c5cc7d
RUN case "$(dpkg --print-architecture)" in \
      amd64) arch=x64; sum="${NODE_SHA256_X64}" ;; \
      arm64) arch=arm64; sum="${NODE_SHA256_ARM64}" ;; \
      *) echo "no Node build pinned for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac \
 && curl -fsSLo /tmp/node.tar.gz "https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-${arch}.tar.gz" \
 && echo "${sum}  /tmp/node.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/node.tar.gz -C /usr/local --strip-components=1 --no-same-owner \
      "node-${NODE_VERSION}-linux-${arch}/bin/node" \
 && rm /tmp/node.tar.gz \
 && node --version

RUN groupadd --gid "${GID}" dev \
 && useradd --create-home --uid "${UID}" --gid "${GID}" --shell /bin/bash dev \
 && mkdir -p /workspace /home/dev/go/pkg/mod /home/dev/.cache/go-build /home/dev/.claude \
 && chown -R dev:dev /workspace /home/dev

USER dev
ENV CLAUDE_CONFIG_DIR=/home/dev/.claude
RUN if [ "$INSTALL_CLAUDE" = "1" ]; then curl -fsSL https://claude.ai/install.sh | bash; fi
ENV GOPATH=/home/dev/go \
    GOCACHE=/home/dev/.cache/go-build \
    PATH=/home/dev/.local/bin:/home/dev/go/bin:/usr/local/go/bin:${PATH}

# Language server and linter. Unpinned on purpose while the project is young; pin them when it settles.
RUN go install golang.org/x/tools/gopls@latest \
 && go install honnef.co/go/tools/cmd/staticcheck@latest \
 && git config --global --add safe.directory /workspace

WORKDIR /workspace
CMD ["bash"]
